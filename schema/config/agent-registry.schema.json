{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vac-web/schema/config/agent-registry.schema.json",
  "title": "AgentRegistry",
  "description": "Stage R4 — declarative agent registry under config/agents/registry.yaml. The live, mutable agent registry is owned by the bridge runtime; this YAML is just a seed/preview source so the operator can review the declared shape without inspecting Rust state.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "agents"],
  "properties": {
    "version": { "type": "integer", "minimum": 0 },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "pattern": "^[a-zA-Z0-9_.:-]+$" },
          "label": { "type": "string" },
          "kind": { "type": "string", "enum": ["mock", "vac-native", "acp"] },
          "command": { "type": "string" },
          "args": { "type": "array", "items": { "type": "string" } },
          "env": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "capabilities_profile": { "type": "string" },
          "enabled": { "type": "boolean" },
          "default": { "type": "boolean" }
        }
      }
    }
  }
}
