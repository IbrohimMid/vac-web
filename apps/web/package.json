{
  "name": "@vac-web/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "size": "size-limit",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium"
  },
  "size-limit": [
    {
      "name": "initial bundle (eager main chunk)",
      "path": "dist/assets/index-*.js",
      "limit": "140 KB",
      "gzip": true,
      "webpack": false
    },
    {
      "name": "tanstack chunk",
      "path": "dist/assets/tanstack-*.js",
      "limit": "60 KB",
      "gzip": true,
      "webpack": false
    },
    {
      "name": "xterm chunk (lazy via ShellDrawer)",
      "path": "dist/assets/xterm-*.js",
      "limit": "90 KB",
      "gzip": true,
      "webpack": false
    }
  ],
  "dependencies": {
    "@noble/ciphers": "^1.0.0",
    "@noble/curves": "^1.6.0",
    "@noble/hashes": "^1.5.0",
    "@tanstack/react-query": "^5.59.20",
    "@tanstack/react-virtual": "^3.10.9",
    "isomorphic-dompurify": "^3.10.0",
    "markdown-it": "^14.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shiki": "^4.0.2",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@size-limit/preset-big-lib": "^11.1.6",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/markdown-it": "^14.1.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^20.9.0",
    "postcss": "^8.4.47",
    "size-limit": "^11.1.6",
    "tailwindcss": "^3.4.14",
    "typescript": "^6.0.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4",
    "@playwright/test": "^1.49.0",
    "@types/ws": "^8.5.13",
    "ws": "^8.18.0"
  }
}
