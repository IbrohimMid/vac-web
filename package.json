{
  "name": "vac-web",
  "private": true,
  "version": "0.1.0",
  "description": "End-to-end software delivery cockpit for VAC",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.10.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "verify:assessment": "bash scripts/verify-assessment-cockpit.sh",
    "codegen": "bash scripts/codegen.sh && node scripts/codegen-command-catalog.mjs && node scripts/codegen-event-catalog.mjs && node scripts/codegen-error-taxonomy.mjs && node scripts/codegen-mock-scenarios.mjs",
    "codegen:catalog": "node scripts/codegen-command-catalog.mjs",
    "codegen:events": "node scripts/codegen-event-catalog.mjs",
    "codegen:errors": "node scripts/codegen-error-taxonomy.mjs",
    "codegen:scenarios": "node scripts/codegen-mock-scenarios.mjs",
    "codegen:verify": "bash scripts/verify-codegen.sh",
    "scaffold:plan": "node scripts/vac-plan-new.mjs",
    "scaffold:capability": "node scripts/vac-capability-new.mjs",
    "scaffold:command": "node scripts/vac-command-new.mjs",
    "vac:check:catalog": "node scripts/check-command-catalog.mjs",
    "vac:check:all": "pnpm codegen:verify && pnpm vac:check:catalog && pnpm manifest:verify",
    "schema:validate": "bash scripts/schema-validate.sh",
    "manifest:verify": "bash scripts/manifest-verify.sh",
    "audit:rust": "bash scripts/audit-rust.sh",
    "pr:checklist": "node scripts/vac-pr-checklist.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yaml,yml}\" --ignore-path .gitignore"
  },
  "pnpm": {
    "overrides": {
      "html-encoding-sniffer": "^4.0.0",
      "@types/node": "22.19.18"
    }
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^6.0.3",
    "ajv": "^8.20.0",
    "ajv-cli": "^5.0.0",
    "ajv-formats": "^3.0.1",
    "json-schema-to-typescript": "^15.0.2",
    "js-yaml": "^4.1.0"
  }
}
