{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vac-web/schema/v1/AssessmentFinding.json",
  "title": "AssessmentFinding",
  "description": "Single finding emitted by an assessor agent. SSOT: docs/assessment-contract.md \u00a73.",
  "type": "object",
  "required": [
    "id",
    "run_id",
    "family_id",
    "category",
    "subsystem",
    "severity",
    "confidence",
    "title",
    "description",
    "evidence",
    "fixability",
    "identity_hash",
    "created_at",
    "emitted_by"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "_defs/primitives.schema.json#/$defs/ulid"
    },
    "run_id": {
      "$ref": "_defs/primitives.schema.json#/$defs/ulid"
    },
    "family_id": {
      "type": "string",
      "pattern": "^assessor\\.[a-z0-9_]+$"
    },
    "category": {
      "type": "string"
    },
    "subsystem": {
      "type": "string"
    },
    "severity": {
      "$ref": "_defs/primitives.schema.json#/$defs/finding_severity"
    },
    "confidence": {
      "$ref": "_defs/primitives.schema.json#/$defs/confidence"
    },
    "title": {
      "type": "string",
      "maxLength": 120
    },
    "description": {
      "type": "string"
    },
    "rationale": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "EvidenceRef.json"
      }
    },
    "suggested_fix": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rationale": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "diff_hint": {
          "type": "string"
        },
        "executor_profile_hint": {
          "$ref": "_defs/primitives.schema.json#/$defs/profile_id_versioned"
        }
      }
    },
    "fixability": {
      "type": "string",
      "enum": [
        "auto",
        "assisted",
        "manual"
      ]
    },
    "owner_hint": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "identity_hash": {
      "$ref": "_defs/primitives.schema.json#/$defs/sha256"
    },
    "created_at": {
      "$ref": "_defs/primitives.schema.json#/$defs/iso8601"
    },
    "emitted_by": {
      "type": "string"
    }
  },
  "x-assertions": [
    "severity=critical implies confidence >= 0.7",
    "evidence must be non-empty (minItems:1)"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "severity": {
            "const": "critical"
          }
        },
        "required": [
          "severity"
        ]
      },
      "then": {
        "properties": {
          "confidence": {
            "minimum": 0.7
          }
        },
        "required": [
          "confidence"
        ]
      }
    }
  ],
  "x-runtime-assertions": [
    "identity_hash must equal sha256(family_id|category|subsystem|normalize(title)|primary_evidence_locator)"
  ]
}
