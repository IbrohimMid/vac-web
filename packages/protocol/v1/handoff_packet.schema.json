{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vac-web/schema/v1/HandoffPacket.json",
  "title": "HandoffPacket",
  "description": "Formal artefact bundling accepted findings + tasks + pin + executor target. SSOT: docs/handoff-contract.md.",
  "type": "object",
  "required": [
    "id", "title", "source_run_ids", "accepted_finding_ids",
    "created_by", "created_at", "pin", "tasks", "target", "approval", "state", "state_history"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "$ref": "_defs/primitives.schema.json#/$defs/ulid" },
    "title": { "type": "string", "maxLength": 120 },
    "summary": { "type": "string", "maxLength": 1000 },
    "source_run_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "_defs/primitives.schema.json#/$defs/ulid" }
    },
    "accepted_finding_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "_defs/primitives.schema.json#/$defs/ulid" }
    },
    "created_by": { "type": "string" },
    "created_at": { "$ref": "_defs/primitives.schema.json#/$defs/iso8601" },
    "pin": {
      "type": "object",
      "required": [
        "repo_ref", "base_commit_sha", "worktree_digest",
        "assessment_snapshot_at", "expires_at",
        "invalidate_on_repo_change", "invalidation_policy"
      ],
      "additionalProperties": false,
      "properties": {
        "repo_ref": { "type": "string" },
        "base_commit_sha": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
        "worktree_digest": { "$ref": "_defs/primitives.schema.json#/$defs/sha256" },
        "assessment_snapshot_at": { "$ref": "_defs/primitives.schema.json#/$defs/iso8601" },
        "connector_snapshots": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["connector_id", "kind", "snapshot_id", "captured_at"],
            "additionalProperties": false,
            "properties": {
              "connector_id": { "type": "string" },
              "kind": { "type": "string" },
              "snapshot_id": { "$ref": "_defs/primitives.schema.json#/$defs/ulid" },
              "captured_at": { "$ref": "_defs/primitives.schema.json#/$defs/iso8601" }
            }
          }
        },
        "expires_at": { "$ref": "_defs/primitives.schema.json#/$defs/iso8601" },
        "invalidate_on_repo_change": { "type": "boolean" },
        "invalidation_policy": { "type": "string", "enum": ["strict", "lenient"] }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "rationale", "steps"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "_defs/primitives.schema.json#/$defs/ulid" },
          "title": { "type": "string" },
          "rationale": { "type": "string" },
          "evidence_refs": { "type": "array", "items": { "$ref": "EvidenceRef.json" } },
          "steps": { "type": "array", "items": { "type": "string" } },
          "constraints": { "type": "array", "items": { "type": "string" } },
          "risk_notes": { "type": "array", "items": { "type": "string" } },
          "est_effort": { "type": "string", "enum": ["hours", "days", "weeks"] },
          "depends_on": { "type": "array", "items": { "$ref": "_defs/primitives.schema.json#/$defs/ulid" } },
          "touches_paths": { "type": "array", "items": { "type": "string" } },
          "requires_approval_per_step": { "type": "boolean", "default": false }
        }
      }
    },
    "order_hint": { "type": "array", "items": { "$ref": "_defs/primitives.schema.json#/$defs/ulid" } },
    "target": {
      "type": "object",
      "required": ["kind", "executor_profile_id"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["dispatch_to_local_vac", "dispatch_to_vac_web_cli", "export_as_blueprint_only"]
        },
        "executor_profile_id": { "$ref": "_defs/primitives.schema.json#/$defs/profile_id_versioned" },
        "session_title": { "type": "string" }
      }
    },
    "approval": {
      "type": "object",
      "required": ["required", "two_party"],
      "additionalProperties": false,
      "properties": {
        "required": { "type": "boolean" },
        "approvers": { "type": "array", "items": { "type": "string" } },
        "approver_notes": { "type": "string" },
        "approved_at": { "$ref": "_defs/primitives.schema.json#/$defs/iso8601" },
        "two_party": { "type": "boolean" },
        "required_roles": { "type": "array", "items": { "type": "string" } }
      }
    },
    "state": {
      "type": "string",
      "enum": [
        "draft", "pending_approval", "approved", "dispatched", "executing",
        "completed", "rejected", "cancelled", "invalidated", "expired"
      ]
    },
    "state_history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["state", "at"],
        "additionalProperties": false,
        "properties": {
          "state": { "type": "string" },
          "at": { "$ref": "_defs/primitives.schema.json#/$defs/iso8601" },
          "by": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "execution_session_id": { "$ref": "_defs/primitives.schema.json#/$defs/ulid" },
    "execution_outcome": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": { "type": "string", "enum": ["success", "partial", "failed", "cancelled"] },
        "tasks_completed": { "type": "array", "items": { "$ref": "_defs/primitives.schema.json#/$defs/ulid" } },
        "tasks_failed": { "type": "array", "items": { "$ref": "_defs/primitives.schema.json#/$defs/ulid" } },
        "changeset_summary": { "type": "string" },
        "reassessment_run_id": { "$ref": "_defs/primitives.schema.json#/$defs/ulid" }
      }
    },
    "chained_from_handoff_id": { "$ref": "_defs/primitives.schema.json#/$defs/ulid" }
  }
}
